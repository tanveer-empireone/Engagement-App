# Server-only settings. Do not put secrets in VITE_ variables.
# Copy to .env for local development. Never commit .env.

# Local example: postgres://USER:PASSWORD@127.0.0.1:5432/e1_dev
DATABASE_URL="postgres://USER:PASSWORD@127.0.0.1:5432/e1_dev"

# Firebase Admin SDK JSON, one line. Or set GOOGLE_APPLICATION_CREDENTIALS to a key file path.
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Service account with editor access on the Drive root folder. One line JSON.
GOOGLE_SERVICE_ACCOUNT_JSON=""

# Optional. Server-side ClickUp read token. Leave empty until ClickUp is configured.
CLICKUP_API_TOKEN=""

# Set to 1 only when applying the JSON snapshot to the staging database.
E1_ALLOW_REMOTE_DATABASE=""
