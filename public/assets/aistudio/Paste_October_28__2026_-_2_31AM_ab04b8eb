function e1Ack_(tid,feedbackId,reply) {
  var key='ack-'+feedbackId,sh=e1Ledger_(),v=sh.getDataRange().getValues(),rn=0,old;
  for(var i=1;i<v.length;i++)if(v[i][0]===key){rn=i+1;old=v[i];break;}
  if(old&&old[3]==='Commented')return;
  var marker='[E1-ACK:'+feedbackId+']',comments=cu_('task/'+tid+'/comment').comments||[];
  var exists=comments.some(function(c){return String(c.comment_text||JSON.stringify(c.comment||[])).indexOf(marker)>=0;});
  if(!rn){sh.appendRow([key,E1_TASKS[tid],tid,'Pending',new Date(),'']);rn=sh.getLastRow();}
  if(!exists&&old&&old[3]==='Uncertain')throw new Error('Uncertain acknowledgment needs Admin reconciliation: '+feedbackId);
  if(!exists){
    sh.getRange(rn,4).setValue('Uncertain');SpreadsheetApp.flush();
    cu_('task/'+tid+'/comment','post',{comment_text:'Read in E1 Engagement Capture'+(reply?': '+reply:'')+'\n'+marker,notify_all:false});
  }
  sh.getRange(rn,4,1,2).setValues([['Commented',new Date()]]);
}
function e1Visible_(p,row) { return e1Wide_(p)||p.Role==='Creative Designer'||p.Role==='Site Manager'||row.Site===p.Site; }
function e1Json_(value) { return JSON.parse(JSON.stringify(value)); }
function appData() {
  var p=guMe_(),ss=ss_(),context=guContext(),now=Date.now();
  var messages=rows_(ss.getSheetByName('Feedback')).filter(function(r){
    var addressed=r.ToAll===true||r.ToSite===p.Site||String(r.ToPerson).toLowerCase()===String(p.Email).toLowerCase();
    return e1Wide_(p)||(r.Status==='Published'&&addressed);
  }).slice(-100).reverse();
  var uploads=rows_(ss.getSheetByName('Uploads')).filter(function(r){return r.UploadID&&e1Visible_(p,r);}).slice(-150).reverse().map(function(r){
    return {id:r.UploadID,officer:r.Officer,site:r.Site,shift:r.Shift,date:r.ShiftDate,topic:r.Topic,status:r.ReviewStatus,note:r.Note,reviewNote:r.ReviewNote,top:r.TopPick,used:r.UsedInFinal,link:r.DriveLink||'',task:r.ClickUpTask};
  });
  var reports=rows_(ss.getSheetByName('Reports')).filter(function(r){return r.ReportID&&(e1Review_(p)||String(r.Officer).toLowerCase()===String(p.Email).toLowerCase());}).slice(-100).reverse();
  return e1Json_({context:context,messages:messages,uploads:uploads,reports:reports,canReview:e1Review_(p)||p.Role==='Creative Designer',canPublish:e1Wide_(p)});
}
function appAcknowledge(id) {
  var p=guMe_(),sh=ss_().getSheetByName('Feedback'),c=cols_(sh),v=sh.getDataRange().getValues();
  var lock=LockService.getScriptLock();lock.waitLock(10000);
  try{
    for(var i=1;i<v.length;i++)if(String(v[i][c.FeedbackID-1])===String(id)){
      var r=v[i],addressed=r[c.ToAll-1]===true||r[c.ToSite-1]===p.Site||String(r[c.ToPerson-1]).toLowerCase()===String(p.Email).toLowerCase();
      if(r[c.Status-1]!=='Published'||(!addressed&&!e1Wide_(p)))throw new Error('This direction is not addressed to you.');
      var own=e1Sheet_('Acknowledgments',['Key','Email','FeedbackID','Time']);
      if(!own.getDataRange().getValues().some(function(x){return x[0]===p.Email+':'+id;}))own.appendRow([p.Email+':'+id,p.Email,id,new Date()]);
      sh.getRange(i+1,c.Acknowledged).setValue(true);sh.getRange(i+1,c.AcknowledgedAt).setValue(new Date());return 'Acknowledged';
    }
    throw new Error('Direction not found.');
  }finally{lock.releaseLock();}
}
function appPublish(id) {
  var p=guMe_();if(!e1Wide_(p))throw new Error('Lead access required.');
  var sh=ss_().getSheetByName('Feedback'),c=cols_(sh),v=sh.getDataRange().getValues();
  for(var i=1;i<v.length;i++)if(String(v[i][c.FeedbackID-1])===String(id)){
    if(String(v[i][c.Source-1]).indexOf('ClickUp:')===0)throw new Error('Approve the source task in ClickUp, then sync.');
    sh.getRange(i+1,c.Status).setValue('Published');sh.getRange(i+1,c.SentAt).setValue(new Date());return 'Published';
  }throw new Error('Draft not found.');
}
function appReview(f) {
  var p=guMe_();if(!e1Review_(p)&&p.Role!=='Creative Designer')throw new Error('Reviewer access required.');
  if(['Accepted','Top pick','Reshoot'].indexOf(f.status)<0)throw new Error('Invalid review decision.');
  if(f.status==='Reshoot'&&!String(f.note||'').trim())throw new Error('Explain what needs to be fixed.');
  var lock=LockService.getScriptLock();lock.waitLock(10000);
  try{var sh=ss_().getSheetByName('Uploads'),c=cols_(sh),v=sh.getDataRange().getValues();
    for(var i=1;i<v.length;i++)if(String(v[i][c.UploadID-1])===String(f.id)){
      if(v[i][c.ConsentSigned-1]!==true||v[i][c.NothingConfidential-1]!==true)throw new Error('Consent checks are incomplete.');
      sh.getRange(i+1,c.ReviewStatus).setValue(f.status);sh.getRange(i+1,c.ReviewNote).setValue(e1Cell_(e1Text_(f.note,2000)));sh.getRange(i+1,c.ReviewedBy).setValue(p.Email);sh.getRange(i+1,c.ReviewedAt).setValue(new Date());return 'Review saved; ClickUp follow-up syncs on the next cycle.';
    }throw new Error('Upload not found.');
  }finally{lock.releaseLock();}
}
