      put('UploadID', id); put('Officer', owner); put('Site', s.SiteName); put('Shift', shiftName);
      put('Mode', 'Daily'); put('ShiftDate', new Date(Number(dp[0]), Number(dp[1]) - 1, Number(dp[2])));
      put('Topic', 'N/A'); put('MediaType', isVideo ? 'Video' : 'Photo');
