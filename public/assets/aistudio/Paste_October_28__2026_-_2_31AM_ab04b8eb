/* ------------------------------------------------- PLACE NAME + MAP LINK */
function updatePlaces_() {
  var sh = ss_().getSheetByName('Uploads'); var c = cols_(sh);
  var n = sh.getLastRow() - 1; if (n < 1) return;
  var loc = sh.getRange(2, c.Location, n, 1).getValues();
  var place = sh.getRange(2, c.Place, n, 1).getValues();
  var map = sh.getRange(2, c.MapLink, n, 1).getValues();
  var geo = Maps.newGeocoder(); var changed = false, calls = 0;
  for (var i = 0; i < n; i++) {
    var s = String(loc[i][0] || '').trim(); if (!s) continue;
    var p = s.split(','); if (p.length < 2) continue;
    var lat = parseFloat(p[0]), lng = parseFloat(p[1]); if (isNaN(lat) || isNaN(lng) || Math.abs(lat)>90 || Math.abs(lng)>180) continue;
    if (!map[i][0]) { map[i][0] = 'https://www.google.com/maps?q=' + lat + ',' + lng; changed = true; }
    if (!place[i][0] && calls < 40) {
      calls++;
      var r = geo.reverseGeocode(lat, lng);
      var foundPlace=placeName_(r); if(foundPlace){place[i][0]=foundPlace;changed=true;}
    }
  }
  if (changed) { sh.getRange(2, c.Place, n, 1).setValues(place); sh.getRange(2, c.MapLink, n, 1).setValues(map); }
}
function placeName_(r) {
  if (!r || r.status !== 'OK' || !r.results.length) return '';
  var city = '', region = '', country = '';
  r.results[0].address_components.forEach(function (a) {
    if (!city && (a.types.indexOf('locality') >= 0 || a.types.indexOf('postal_town') >= 0)) city = a.long_name;
    if (!region && a.types.indexOf('administrative_area_level_1') >= 0) region = a.short_name;
    if (!country && a.types.indexOf('country') >= 0) country = a.short_name;
  });
  if (!city) r.results[0].address_components.forEach(function (a) {
    if (!city && a.types.indexOf('administrative_area_level_2') >= 0) city = a.long_name; });
  return [city, region, country].filter(String).join(', ');
}

