/** Header -> column index (1-based) map; adds missing headers at the end. */
function cols_(sh, needed) {
  var lastCol = sh.getLastColumn();
  var head = sh.getRange(1, 1, 1, lastCol).getValues()[0];
  var map = {};
  head.forEach(function (h, i) { if (h) map[h] = i + 1; });
  (needed || []).forEach(function (n) {
    if (!map[n]) {
      lastCol += 1;
      sh.getRange(1, lastCol).setValue(n).setFontWeight('bold');
      map[n] = lastCol;
    }
  });
  return map;
}

