function runAll_() {
  var p = props_(), runner = p.getProperty('RUN_AS');
  if (p.getProperty('PAUSED')) return;
  if (!runner || String(Session.getEffectiveUser().getEmail()).toLowerCase() !== runner.toLowerCase()) return;
  var lock = LockService.getScriptLock(); if (!lock.tryLock(5000)) return;
  E1_DEADLINE = Date.now()+240000; var errors = [];
  try {
    [['places',updatePlaces_],['directions',clickupPullDirections_],['followups',clickupPushFollowUps_],['events',clickupEventFlows_]].forEach(function(stage) {
      try { e1Within_(); if (stage[0] !== 'places' && !p.getProperty('CLICKUP_TOKEN')) throw new Error('ClickUp token is missing.'); stage[1](); e1Log_(stage[0],'OK','Completed'); }
      catch(e) { errors.push(stage[0]+': '+e.message); e1Log_(stage[0],'Error',e.message); console.error(stage[0]+': '+e.message); }
    });
    p.setProperty('E1_LAST_SYNC',new Date().toISOString()); p.setProperty('E1_SYNC_STATE',errors.length?'Error':'OK');
  } finally { lock.releaseLock(); }
  if (errors.length) throw new Error(errors.join(' | '));
}
