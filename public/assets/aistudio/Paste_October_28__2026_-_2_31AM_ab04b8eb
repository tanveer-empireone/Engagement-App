// Every "Notes by Gemini" doc is checked. Two ways in:
//  1. Team meetings (title contains a TEAM word): the whole summary + next steps, to all officers.
//  2. Any other meeting: ONLY lines about engagement (ENGAGEMENT_WORDS), never lines with PRIVATE_WORDS.
//     Lines naming a site go to that site; the rest go to all officers.
// Everything arrives as a Draft. Nothing reaches officers until a lead taps "Publish to team".
var MEET_KEYWORDS = ['team brief', 'huddle', 'town hall', 'all hands', 'officers briefing'];
var ENGAGEMENT_WORDS = ['engagement', 'event', 'celebrat', 'recognition', 'award', 'birthday', 'anniversar', 'huddle',
  'town hall', 'team building', 'contest', 'raffle', 'games', 'activity', 'activities', 'morale', 'survey', 'wellness',
  'photo', 'video', 'filming', 'film ', 'content', 'social media', 'post ', 'posting', 'shout-out', 'shoutout', 'theme',
  'campaign', 'decorat', 'officer', 'floor', 'testimonial', 'culture', 'holiday', 'christmas', 'halloween', 'party'];
var PRIVATE_WORDS = ['hire', 'hiring', 'recruit', 'candidate', 'interview', 'resume', 'salary', 'salaries', 'pay ',
  'payroll', 'compensation', 'bonus', 'raise', 'terminat', 'disciplin', 'performance review', 'pip ', 'layoff',
  'budget', 'cost', 'invoice', 'contract', 'client', 'customer data', 'confidential', 'legal', 'lawsuit', 'medical',
  'resign', 'promotion', 'headcount', 'pricing', 'revenue', 'suspen', 'attrition', 'absen', 'tardi', 'warning',
  'incident report', 'names of', 'capacity', 'staffing', 'schedule adherence', 'kpi', 'metrics'];
// Meetings with these words in the title are never used (leadership / project meetings).
var SKIP_TITLES = ['website', 'brd', 'capacity', 'interview', '1:1', 'one on one', 'performance', 'budget', 'client', 'sales', 'finance', 'hr '];
var SITE_WORDS = { 'Cebu City': ['cebu'], 'Carcar': ['carcar'], 'San Carlos': ['san carlos', 'st. carlos', 'st carlos'],
  'Urdaneta': ['urdaneta'], 'Toronto': ['toronto'], 'Santa Marta': ['santa marta'] };

/** Action items start with [Owner]. Keep them only when the owner is the team/group or someone in the People sheet. */
var PEOPLE_NAMES_ = null;
function forTeam_(line) {
  var m = line.match(/^\[([^\]]+)\]/); if (!m) return true;
  var owner = m[1].toLowerCase();
  if (/\b(group|team|all|everyone|officers?)\b/.test(owner)) return true;
  if (!PEOPLE_NAMES_) PEOPLE_NAMES_ = rows_(ss_().getSheetByName('People')).map(function (p) { return String(p.Name).toLowerCase(); });
  return PEOPLE_NAMES_.some(function (n) { return n.split(/\s+/).some(function (w) { return w.length >= 4 && owner.indexOf(w) >= 0; }); });
}
function hasAny_(s, words) { s = ' ' + s.toLowerCase() + ' '; return words.some(function (w) { return s.indexOf(w) >= 0; }); }

function importMeetNotes_(sinceOverride) {
  var since = sinceOverride || props_().getProperty('MEET_SINCE') || new Date(Date.now() - 2 * 864e5).toISOString();
  var q = "title contains 'Notes by Gemini' and mimeType = 'application/vnd.google-apps.document' and modifiedDate > '" + since + "'";
  var files = DriveApp.searchFiles(q);
  var fb = ss_().getSheetByName('Feedback'); var c = cols_(fb);
  var existing = fb.getLastRow() > 1 ? fb.getRange(2, c.Source, fb.getLastRow() - 1, 1).getValues().map(function (r) { return String(r[0]); }) : [];
  var newest = since, added = 0;
  while (files.hasNext()) {
    var f = files.next(); var title = f.getName();
    var mod = f.getLastUpdated().toISOString(); if (mod > newest) newest = mod;
    var src = 'Meet:' + f.getId();
    if (existing.some(function (e) { return e.indexOf(src) === 0; })) continue;
    var text = DocumentApp.openById(f.getId()).getBody().getText();
    var short = title.replace(/ - Notes by Gemini.*$/i, '');
    var groups = {};
    if (hasAny_(title, SKIP_TITLES)) { existing.push(src); continue; }
    if (hasAny_(title, MEET_KEYWORDS)) {
      var all = meetDigest_(text).split('\n').filter(function (l) { return !hasAny_(l, PRIVATE_WORDS); });
      if (all.length) groups['ALL'] = all;
    } else {
      meetLines_(text).forEach(function (l) {
        if (!hasAny_(l, ENGAGEMENT_WORDS) || hasAny_(l, PRIVATE_WORDS)) return;
        if (!forTeam_(l)) return;
        var site = Object.keys(SITE_WORDS).filter(function (s) { return hasAny_(l, SITE_WORDS[s]); });
        var key = site.length === 1 ? site[0] : 'ALL';
        (groups[key] = groups[key] || []).push(l);
      });
    }
    Object.keys(groups).forEach(function (key) {
      var msg = groups[key].join('\n'); if (msg.length > 1800) msg = msg.slice(0, 1800) + '...';
      var row = new Array(fb.getLastColumn()).fill('');
      row[c.FeedbackID - 1] = Utilities.getUuid().slice(0, 8);
      if (key === 'ALL') row[c.ToAll - 1] = true; else row[c.ToSite - 1] = key;
      row[c.FromPerson - 1] = Session.getEffectiveUser().getEmail();
      row[c.Type - 1] = 'Theme to communicate';
      row[c.Message - 1] = msg + '\n\nFrom meeting: ' + short;
      row[c.SentAt - 1] = new Date(); row[c.Acknowledged - 1] = false;
      row[c.Status - 1] = 'Draft'; row[c.Source - 1] = src + (key === 'ALL' ? '' : ':' + key); row[c.Title - 1] = short;
      fb.appendRow(row); added++;
    });
    if (!Object.keys(groups).length) { existing.push(src); }
  }
  if (!sinceOverride) props_().setProperty('MEET_SINCE', newest);
  return added + ' draft(s) added';
}
/** Summary and next-steps lines, one item per line (paragraphs kept whole). */
function meetLines_(text) {
  var lines = text.split(/\n/).map(function (l) { return l.trim(); }).filter(String), out = [], keep = false;
  lines.forEach(function (l) {
    var h = l.toLowerCase();
    if (/^(summary|suggested next steps|next steps|action items)$/.test(h)) { keep = true; return; }
    if (/^(details|transcript|attachments|invited)/.test(h) || /^(want to see more|tip:|you should review gemini)/.test(h)) { keep = false; return; }
    if (keep) out.push(l);
  });
  return out;
}
/** Test helper: re-checks the last 7 days of meeting notes without moving the bookmark. */
function testMeetNotes_() { return importMeetNotes_(new Date(Date.now() - 7 * 864e5).toISOString()); }

/** Keeps the Summary and Next steps sections, trimmed for phones. */
function meetDigest_(text) {
  var lines = text.split(/\n/).map(function (l) { return l.trim(); }).filter(String);
  var out = [], keep = false;
  lines.forEach(function (l) {
    var h = l.toLowerCase();
    if (/^(summary|suggested next steps|next steps|action items)$/.test(h)) { keep = true; out.push(l.toUpperCase()); return; }
    if (/^(details|transcript|attachments|invited)/.test(h)) { keep = false; return; }
    if (keep) out.push(l);
  });
  var s = out.join('\n');
  return s.length > 1800 ? s.slice(0, 1800) + '...' : s;
}

