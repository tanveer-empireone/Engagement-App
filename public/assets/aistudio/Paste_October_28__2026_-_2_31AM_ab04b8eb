function cu_(path, method, body) {
  method = String(method || 'get').toLowerCase(); cuGuard_(path,method);
  var token=props_().getProperty('CLICKUP_TOKEN'); if (!token) throw new Error('ClickUp token missing.');
  var o={method:method,headers:{Authorization:token},muteHttpExceptions:true,contentType:'application/json'};
  if(body) o.payload=JSON.stringify(body);
  for(var attempt=0;attempt<3;attempt++) {
    e1Within_(); var r=UrlFetchApp.fetch('https://api.clickup.com/api/v2/'+path,o), code=r.getResponseCode();
    if(code>=200&&code<300) return JSON.parse(r.getContentText()||'{}');
    if(method==='get'&&(code===429||code>=500)&&attempt<2) { Utilities.sleep((attempt+1)*1500); continue; }
    throw new Error('ClickUp request failed ('+code+') at '+path.split('?')[0]);
  }
}
/** Finds list ids by name once and caches them. */
function cuLists_() {
  if (typeof E1_LISTS !== 'undefined' && E1_LISTS) return E1_LISTS;
  var out={daily:{},events:{},content:null,surveys:null,followups:null};
  cu_('space/'+E1_SPACE+'/folder?archived=false').folders.forEach(function(f) {
    (f.lists||[]).forEach(function(l) {
      Object.keys(SITE_FOLDERS).forEach(function(site) { if(f.name===SITE_FOLDERS[site]) { if(l.name==='Daily Tasks') out.daily[site]=String(l.id); if(l.name==='Events & Activities') out.events[site]=String(l.id); } });
      if(f.name==='Engagement HQ'&&l.name==='Marketing Content Handoff') out.content=String(l.id);
      if(f.name==='Engagement HQ'&&l.name==='Capture App Follow-ups') out.followups=String(l.id);
      if(f.name==='Engagement HQ'&&l.name==='Surveys') out.surveys=String(l.id);
    });
  });
  if(Object.keys(out.daily).length!==4||Object.keys(out.events).length!==4||!out.content||!out.followups) throw new Error('Engagement list mapping is incomplete.');
  props_().setProperty('CU_SPACE_ID',E1_SPACE); props_().setProperty('CU_LISTS',JSON.stringify(out));
  E1_LISTS=out; return out;
}
/** Open tasks in each site's Daily Tasks list -> Today (directions). Tag "theme" = theme; tag "all" = every site. */
function clickupPullDirections_() {
  var L=cuLists_(), fb=ss_().getSheetByName('Feedback'), c=cols_(fb), data=fb.getDataRange().getValues(), src={}, active={}, current={};
  for(var i=1;i<data.length;i++) src[String(data[i][c.Source-1])]=i+1;
  Object.keys(L.daily).forEach(function(site) {
    var s=guSite_(site),tz=siteTz_(s.Code),today=Utilities.formatDate(new Date(),tz,'yyyy-MM-dd');
    e1ListTasks_(L.daily[site],true).forEach(function(t) {
      current[t.id]=t;
      if(!e1Eligible_(t,today,tz)) return;
      var due=t.due_date?Utilities.formatDate(new Date(Number(t.due_date)),tz,'yyyy-MM-dd'):'nodue',key='ClickUp:'+t.id+':'+due,tags=e1Tags_(t);
      active[key]=true;
      var rn=src[key]||src['ClickUp:'+t.id],old=rn?data[rn-1]:null,row=old?old.slice():new Array(fb.getLastColumn()).fill('');
      var msg=t.name+(t.description?'\n'+t.description.slice(0,1500):'')+'\n\nClickUp: '+(t.url||'https://app.clickup.com/t/'+t.id);
      row[c.FeedbackID-1]=old?old[c.FeedbackID-1]:Utilities.getUuid().slice(0,12);
      row[c.ToAll-1]=tags.indexOf('all')>=0; row[c.ToSite-1]=tags.indexOf('all')>=0?'':site;
      row[c.FromPerson-1]=(t.creator&&t.creator.email)||'';
      row[c.Type-1]=tags.indexOf('theme')>=0?'Theme to communicate':"Today's tasks";
      var changed=!old||old[c.Message-1]!==msg;
      row[c.Message-1]=e1Cell_(msg); row[c.Title-1]=e1Cell_(t.name); row[c.Source-1]=key;
      row[c.Status-1]=(tags.indexOf('draft')>=0||tags.indexOf('review')>=0)?'Draft':'Published';
      if(changed||!old||old[c.Status-1]!=='Published'||(old[c.SentAt-1] instanceof Date&&Utilities.formatDate(old[c.SentAt-1],tz,'yyyy-MM-dd')!==today)) row[c.SentAt-1]=new Date();
      if(changed) { row[c.Acknowledged-1]=false; row[c.Reply-1]=''; row[c.AcknowledgedAt-1]=''; }
      if(rn) fb.getRange(rn,1,1,row.length).setValues([row]); else { fb.appendRow(row); src[key]=fb.getLastRow(); }
    });
  });
  // Withdraw closed, postponed, unapproved or deleted directions already imported.
  data=fb.getDataRange().getValues();
  for(var j=1;j<data.length;j++) {
    var key=String(data[j][c.Source-1]);
    if(key.indexOf('ClickUp:')===0&&!active[key]) fb.getRange(j+1,c.Status).setValue('Draft');
  }
  var v=fb.getDataRange().getValues();
  for(var k=1;k<v.length;k++) {
    var r=v[k],source=String(r[c.Source-1]),tid=(source.match(/^ClickUp:([^:]+)/)||[])[1];
    if(!tid||!E1_TASKS[tid]||r[c.Acknowledged-1]!==true||r[c.Status-1]!=='Published') continue;
    e1Ack_(tid,String(r[c.FeedbackID-1]),e1Text_(r[c.Reply-1],1000));
  }
}
/** Reshoots and reviewer Top picks -> ClickUp tasks. Late reports -> task for the Site Manager. */
function clickupPushFollowUps_() {
